/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'KRAKEN2_KRAKEN2' {
        ext.args = { "--confidence ${params.kraken2_confidence}" }
    }

    withName: 'UMITOOLS_EXTRACT' {
        ext.args = {
            [
                params.umitools_bc_pattern      ? "--bc-pattern='${params.umitools_bc_pattern}'"        : '',
                params.umitools_bc_pattern2     ? "--bc-pattern2='${params.umitools_bc_pattern2}'"       : '',
                params.umitools_umi_separator   ? "--umi-separator='${params.umitools_umi_separator}'"   : '',
            ].join(' ').trim()
        }
    }

    // The reference fasta/GTF are decompressed purely so STAR can read
    // them — a full GRCh38 fasta is ~3GB uncompressed and is already on
    // disk in its original form, so there's no reason to copy it into
    // the results dir.
    withName: 'GUNZIP_FASTA|GUNZIP_GTF|GUNZIP_VCF' {
        publishDir = [ enabled: false ]
    }

    withName: 'STAR_GENOMEGENERATE' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            enabled: params.save_reference
        ]
    }

    withName: 'STAR_ALIGN_WASP' {
        ext.args = {
            [
                // Sort inside STAR rather than piping through a separate
                // samtools sort — phASER and UMI-tools dedup both want a
                // coordinate-sorted genome BAM anyway.
                '--outSAMtype BAM SortedByCoordinate',
                // Give the BAM sorter its own RAM budget, well under the
                // task's total (STAR also holds the whole genome index in
                // memory at the same time). Without this STAR guesses from
                // the genome size and frequently OOMs on real data.
                "--limitBAMsortRAM ${(task.memory.toBytes() * 0.5) as Long}",
                // Second BAM in transcript coordinates for Salmon, plus a
                // per-gene count table that MultiQC picks up for free.
                '--quantMode TranscriptomeSAM GeneCounts',
                // Salmon's alignment mode can't use a read whose mate didn't
                // also map to the transcript, so ban single-end records in
                // the transcriptome BAM. Indels/softclips are kept — Salmon
                // handles those fine (RSEM would need them banned too).
                // NOTE: this is the STAR >= 2.7.11b spelling; older STAR
                // called it `--quantTranscriptomeBan Singleend`.
                '--quantTranscriptomeSAMoutput BanSingleEnd',
                // Reads come in gzipped from fastp/BBSplit/SortMeRNA.
                '--readFilesCommand zcat',
                // Two-pass: run once to discover novel junctions across the
                // sample, reinsert them, then realign. Costs ~2x runtime but
                // materially improves sensitivity to the non-canonical
                // splicing events a rare-disease case actually turns on.
                '--twopassMode Basic',
                // ENCODE-standard filters (also what nf-core/rnaseq uses).
                '--outFilterMultimapNmax 20',
                '--alignSJDBoverhangMin 1',
                '--outSAMstrandField intronMotif',
                // NM/MD carry the per-read mismatch info that allele-specific
                // expression tooling downstream reads. With WASP on, add
                // vA/vG/vW: the allele seen, the variant it came from, and
                // the pass/fail verdict phASER filters on. The verdict tags
                // are only emitted if they're requested here — the module's
                // --waspOutputMode flag alone produces nothing readable.
                '--outSAMattributes NH HI AS NM MD' + (params.wasp_ase ? ' vA vG vW' : ''),
                // Fixed seed so a rerun places multimappers identically.
                '--runRNGseed 0',
            ].join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/star" },
            mode: params.publish_dir_mode,
            // Log.out is STAR's multi-megabyte internal debug trace; the
            // useful summary is Log.final.out, which is kept.
            saveAs: { filename -> filename.endsWith('Log.out') ? null : filename }
        ]
    }

    // The .bai of the raw STAR BAM only exists so umi_tools dedup can seek
    // in it; the deduplicated BAM is what gets published, so this index
    // would just be a stale sidecar next to a file nobody should use.
    withName: 'SAMTOOLS_INDEX_STAR' {
        publishDir = [ enabled: false ]
    }

    withName: 'UMITOOLS_DEDUP' {
        // The input is <id>.Aligned.sortedByCoord.out.bam, so any prefix
        // distinct from that works — but name it for what it is, since this
        // is the BAM phASER will read.
        ext.prefix = { "${meta.id}.umi_dedup.sorted" }
        ext.args = {
            [
                // Must match what UMITOOLS_EXTRACT used, or dedup won't find
                // the UMI in the read name and will silently dedup on
                // position alone — which is the exact failure UMIs exist to
                // avoid, and it produces no error.
                params.umitools_umi_separator ? "--umi-separator='${params.umitools_umi_separator}'" : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/umitools/dedup" },
            mode: params.publish_dir_mode
        ]
    }

    // Index of the deduplicated genome BAM — published alongside it, since
    // phASER (and IGV) need random access by coordinate.
    withName: 'SAMTOOLS_INDEX_DEDUP' {
        publishDir = [
            path: { "${params.outdir}/umitools/dedup" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BAM_KEEP_READNAMES' {
        ext.prefix = { "${meta.id}.umi_dedup.toTranscriptome" }
        publishDir = [
            path: { "${params.outdir}/umitools/dedup" },
            mode: params.publish_dir_mode,
            // The read-name list is a multi-GB intermediate, not a result.
            saveAs: { filename -> filename.endsWith('.readnames.txt') ? null : filename }
        ]
    }

    // -w writes the spliced (mature) transcript sequence for every transcript
    // in the GTF; -g supplies the genome to pull the exon sequence from.
    // The result must stay in lockstep with the GTF STAR indexed — Salmon in
    // alignment mode refuses a transcript set that doesn't match the BAM.
    withName: 'GFFREAD' {
        ext.args = '-w'
        ext.prefix = { "${meta.id}_transcripts" }
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            enabled: params.save_reference
        ]
    }

    withName: 'GUNZIP_TRANSCRIPT_FASTA' {
        publishDir = [ enabled: false ]
    }

    withName: 'SALMON_QUANT' {
        ext.args = [
            // Random-hexamer priming leaves a reproducible signature in the
            // first few bases of every read; --seqBias models it instead of
            // letting it read out as real expression difference.
            '--seqBias',
            // Library prep under/over-amplifies fragments by GC content.
            // Matters here because it's transcript-specific — a GC-rich
            // isoform looks depleted relative to its GC-neutral sibling,
            // which is exactly the comparison a rare-disease call rests on.
            '--gcBias',
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/salmon" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
