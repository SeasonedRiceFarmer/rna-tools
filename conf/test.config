/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run SeasonedRiceFarmer/rna-tools -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 8,
        memory: '16.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    // A tiny, real, human whole-blood RNA-seq sample (20,000 read pairs, subsampled
    // from public SRA run SRR23992075) bundled in the repo itself, so the test never
    // depends on downloading anything. See assets/test_data/README.md for exactly
    // where this data came from and its limitations.
    input = "${projectDir}/assets/test_data/samplesheet_test.csv"

    // Reference genome — chromosome 21 only, to keep this fast on a laptop.
    // Not wired into the workflow yet (added ahead of the STAR step).
    // NOTE: this also stands in as BBSplit's "primary/human" reference below —
    // since it's chr21-only, reads from other chromosomes won't match it and
    // will fall out as non-primary. Fine for exercising the BBSplit wiring;
    // swap in a full genome for a real read-recovery number.
    fasta = "${projectDir}/assets/test_data/reference/genome_chr21.fa.gz"
    gtf   = "${projectDir}/assets/test_data/reference/genes_chr21.gtf.gz"

    // Kraken2 + BBSplit contamination screening
    // The Kraken2 DB is NOT bundled — at ~6GB compressed it breaks this
    // profile's "no downloads" design, so it's fetched once into data/
    // (git-ignored) rather than committed. See conf/test.config's git history
    // or ask for the download command if data/kraken2_db is missing.
    run_kraken2          = true
    kraken2_db           = "${projectDir}/data/kraken2_db"
    kraken2_taxid_lookup = "${projectDir}/assets/test_data/kraken2_taxid_lookup_test.csv"

    perform_bbsplit      = true
    // A real, bundled contaminant genome (E. coli K-12, ~1.4MB compressed —
    // small enough to commit, unlike the Kraken2 DB) so BBSplit always has
    // something to screen against, independent of whatever Kraken2 flags.
    bbsplit_fasta_list   = "${projectDir}/assets/test_data/bbsplit_fasta_list_test.csv"

    // SortMeRNA rRNA removal
    // Bundled reference is a 200-sequence subset of SortMeRNA's own
    // rfam-5.8s test database (~40KB, uncompressed — sortmerna 4.3.7 doesn't
    // accept gzipped references) — real rRNA sequence, small enough to
    // commit, just enough to exercise indexing + filtering. Not a
    // comprehensive rRNA database; swap in a full one (e.g. SILVA) for a
    // real depletion-rate number.
    remove_ribo_rna         = true
    ribo_database_manifest  = "${projectDir}/assets/test_data/ribo_database_manifest_test.txt"
}
